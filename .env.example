# Copy to .env and fill in real values for local development.

# --- Database (Prisma / PostgreSQL) ---
# Matches docker-compose.yml. If you're using a locally installed Postgres
# instead of Docker, point this at your own instance/database.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/attention_os"

# --- Auth.js (next-auth v5) ---
# Generate with: openssl rand -base64 32
AUTH_SECRET=""
# Base URL of the app. Used by Auth.js for callback URLs.
AUTH_URL="http://localhost:3000"

# --- Google sign-in (optional) ---
# From a Google Cloud OAuth 2.0 Client ID (Web application). Authorized
# redirect URI must be <AUTH_URL>/api/auth/callback/google. Google can only
# sign in an email that already has a User row (created via seed/invite) —
# there's no self-serve signup, so leaving these unset just hides the button.
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# --- AI provider (OpenAI) ---
# Required for the classification pipeline (server/providers/ai/openai.provider.ts).
# Leave unset in environments that only need to exercise the deterministic
# parts of the pipeline (extraction, review, Client Brain) — classification
# calls will fail loudly instead of fabricating results.
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4.1-mini"

# --- Local file storage (LocalStorageProvider) ---
# Absolute or repo-relative path where uploaded source originals are stored.
STORAGE_LOCAL_ROOT=".data/uploads"

# --- App ---
NEXT_PUBLIC_APP_URL="http://localhost:3000"
