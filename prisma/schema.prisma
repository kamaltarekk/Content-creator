// Commercial Attention OS — Module 1 data model.
// Source Library (everything uploaded) and Client Brain (only reviewed and
// approved strategic knowledge) are deliberately separate object graphs,
// joined only through traceability rows (ClientBrainItemSource) and the
// review pipeline (ExtractedItem -> ImportReview -> ClientBrainItem).

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// =========================================================================
// ENUMS
// =========================================================================

enum OrgRole {
  OWNER
  ADMIN
  STRATEGIST
  EDITOR
  VIEWER
  CLIENT_APPROVER
}

enum ClientRole {
  OWNER
  ADMIN
  STRATEGIST
  EDITOR
  VIEWER
  CLIENT_APPROVER
}

enum BrandType {
  PERSONAL_BRAND
  COMPANY_BRAND
  HYBRID
}

enum ClientStatus {
  ACTIVE
  ARCHIVED
}

enum ConfidentialityLevel {
  INTERNAL
  CLIENT_CONFIDENTIAL
  RESTRICTED
}

enum SourceCategory {
  STRATEGIC_FRAMEWORK
  MARKET_RESEARCH
  CUSTOMER_FEEDBACK
  SALES_DATA
  BRAND_GUIDELINES
  PERFORMANCE_REPORT
  MEETING_NOTES
  COMPETITOR_INTEL
  OTHER
}

enum SourceFileType {
  CSV
  XLSX
  PDF
  DOCX
  TXT
  MARKDOWN
  IMAGE
  AUDIO
  VIDEO
}

enum SourceProcessingStatus {
  UPLOADED
  QUEUED
  PROCESSING
  NEEDS_ATTENTION
  READY_FOR_REVIEW
  COMPLETED
  FAILED
}

enum JobStatus {
  PENDING
  RUNNING
  SUCCEEDED
  FAILED
  CANCELLED
}

enum JobType {
  PROCESS_SOURCE
}

enum BlockType {
  HEADING
  PARAGRAPH
  TABLE_ROW
  LIST_ITEM
  NOTE
  LINK
  QUOTE
  MESSAGE
}

enum InformationType {
  STRATEGIC_FACT
  CLIENT_PREFERENCE
  AUDIENCE_SIGNAL
  EVIDENCE
  HYPOTHESIS
  EXAMPLE
  PERFORMANCE_LEARNING
  RAW_NOTE
  EXTERNAL_SOURCE
  CONFLICT
  MISSING_INFORMATION
}

enum ExtractedItemValidationStatus {
  PENDING
  VALID
  INVALID
}

enum ImportReviewStatus {
  PENDING
  RESOLVED
}

enum ImportReviewAction {
  APPROVE
  APPROVE_WITH_EDIT
  REJECT
  REMAP
  KEEP_AS_RAW
  MARK_HYPOTHESIS
  MARK_AUDIENCE_SIGNAL
  MARK_EVIDENCE
  RESOLVE_CONFLICT
}

enum ClientBrainSectionKey {
  BUSINESS
  POSITIONING
  MARKETS
  COHORTS
  BELIEFS
  VOICE
  OFFERS
  PROOF
  BRAND_ASSOCIATIONS
  PRODUCTION
  COMMERCIAL_OBJECTIVES
  CONSTRAINTS
  PROHIBITED_CLAIMS
  LEARNINGS
}

