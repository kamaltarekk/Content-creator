  BUSINESS_MODEL
  PRODUCTS_SERVICES
  REVENUE_MODEL
  BUYER
  PAYER
  SALES_PROCESS
  // POSITIONING
  CATEGORY
  CORE_PROMISE
  DIFFERENTIATION
  POINT_OF_VIEW
  BELIEFS_CHALLENGED
  BELIEFS_REINFORCED
  EXPERTISE_BOUNDARIES
  NON_TARGET_WORK
  // MARKETS
  MARKET_NAME
  GEOGRAPHY
  MARKET_PROBLEM
  DEMAND
  MARKET_PURCHASING_POWER
  GROWTH
  COMPETITION
  // COHORTS
  COHORT_NAME
  ROLE
  COMMERCIAL_SITUATION
  TRIGGER
  ACTIVE_PROBLEM
  CURRENT_BELIEF
  DESIRED_OUTCOME
  BUYING_ROLE
  COHORT_PURCHASING_POWER
  PLATFORM_PRESENCE
  // BELIEFS
  WRONG_BELIEF
  BELIEF_EVIDENCE
  BETTER_BELIEF
  COMMERCIAL_CONSEQUENCE
  BETTER_DECISION
  RELEVANT_OFFER
  // VOICE
  LANGUAGE
  DIALECT
  TONE
  VOCABULARY
  SENTENCE_STYLE
  HUMOR
  PROHIBITED_PHRASES
  TERMINOLOGY
  // OFFERS
  OFFER_NAME
  TARGET_COHORT
  PROMISE
  OUTCOME
  DELIVERY
  PRICE
  OFFER_PROOF
  GUARANTEE
  FAST_WIN
  CTA_ROUTE
