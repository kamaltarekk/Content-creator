 */
enum StrategyEntityStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

/**
 * Human-approval trust state for AI-influenced strategy entities. Mirrors the
 * Client Brain trust boundary: AI_SUGGESTED never implies approved, and
 * nothing here is ever silently promoted to APPROVED without a human action.
 */
