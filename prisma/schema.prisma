// =========================================================================
// CORE / AUTH
// =========================================================================

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  orgMemberships    OrganizationMember[]
  clientMemberships ClientMember[]
  auditLogs         AuditLog[]
}

model Organization {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members   OrganizationMember[]
  clients   Client[]
  auditLogs AuditLog[]
}

model OrganizationMember {
  id             String   @id @default(cuid())
  organizationId String
  userId         String
  role           OrgRole
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id])
  user         User         @relation(fields: [userId], references: [id])

  @@unique([organizationId, userId])
  @@index([userId])
}

// =========================================================================
// CLIENT
// =========================================================================

model Client {
  id               String       @id @default(cuid())
  organizationId   String
  name             String
  displayName      String
  brandType        BrandType
  primaryMarket    String?
  defaultLanguage  String       @default("en")
  timeZone         String       @default("UTC")
  shortDescription String?
  status           ClientStatus @default(ACTIVE)
  archivedAt       DateTime?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  organization     Organization         @relation(fields: [organizationId], references: [id])
  members          ClientMember[]
  sources          Source[]
  brainItems       ClientBrainItem[]
  brainSections    ClientBrainSection[]
  conflicts        Conflict[]
  missingDataItems MissingDataItem[]
  tags             Tag[]
  auditLogs        AuditLog[]

  // Module 2 — Cohort + Buying Decision + Belief Intelligence
  cohorts                    Cohort[]
  commercialSituations       CommercialSituation[]
  buyingDecisions            BuyingDecision[]
  beliefMaps                 BeliefMap[]
  evidenceLinks              EvidenceLink[]
  strategicEntities          StrategicEntity[]
  strategicRelationships     StrategicRelationship[]
  strategySuggestions        StrategySuggestion[]
  strategyReadinessSnapshots StrategyReadinessSnapshot[]

  // Module 3 — Guided Client Setup + Script Intelligence Compiler + First Reel Generator
  guidedSetupSessions    GuidedSetupSession[]
  guidedSetupAnswers     GuidedSetupAnswer[]
  scriptIntelligence     ScriptIntelligenceField[]
  scriptContextSnapshots ScriptContextSnapshot[]
  offers                 Offer[]
  proofItems             ProofItem[]
  reelGenerations        ReelGeneration[]

  @@unique([organizationId, name])
  @@index([organizationId, status])
}

model ClientMember {
  id         String     @id @default(cuid())
  clientId   String
  userId     String
  role       ClientRole
  assignedAt DateTime   @default(now())

  client Client @relation(fields: [clientId], references: [id])
  user   User   @relation(fields: [userId], references: [id])

  @@unique([clientId, userId])
  @@index([userId])
}

// =========================================================================
// SOURCE LIBRARY
// =========================================================================

model Source {
  id                     String                 @id @default(cuid())
  clientId               String
  fileName               String
  originalFileName       String
  fileType               SourceFileType
  mimeType               String
  sizeBytes              Int
  checksumSha256         String
  storageKey             String
  sourceCategory         SourceCategory
  title                  String?
  description            String?
  confidentiality        ConfidentialityLevel   @default(INTERNAL)
  processingStatus       SourceProcessingStatus @default(UPLOADED)
  processingInstructions String?
  currentVersionNumber   Int                    @default(1)
  requiresMultimodal     Boolean                @default(false)
  uploadedById           String
  isDeleted              Boolean                @default(false)
  deletedAt              DateTime?
  createdAt              DateTime               @default(now())
  updatedAt              DateTime               @updatedAt

  client         Client                @relation(fields: [clientId], references: [id])
  versions       SourceVersion[]
  blocks         SourceBlock[]
  extractedItems ExtractedItem[]
  jobs           SourceProcessingJob[]
  tags           Tag[]

  @@index([clientId, processingStatus])
  @@index([clientId, checksumSha256])
  @@index([clientId, isDeleted])
}

model SourceVersion {
  id             String   @id @default(cuid())
  sourceId       String
  versionNumber  Int
  storageKey     String
  checksumSha256 String
  sizeBytes      Int
  uploadedById   String
  changeNote     String?
  createdAt      DateTime @default(now())

  source Source        @relation(fields: [sourceId], references: [id])
  blocks SourceBlock[]

  @@unique([sourceId, versionNumber])
}

model SourceProcessingJob {
  id              String    @id @default(cuid())
  sourceId        String
  sourceVersionId String?
  jobType         JobType   @default(PROCESS_SOURCE)
  status          JobStatus @default(PENDING)
  attempts        Int       @default(0)
  maxAttempts     Int       @default(3)
  scheduledAt     DateTime  @default(now())
  startedAt       DateTime?
  finishedAt      DateTime?
  errorMessage    String?
  resultSummary   Json?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  source Source @relation(fields: [sourceId], references: [id])

  @@index([status, scheduledAt])
  @@index([sourceId])
}

model SourceBlock {
  id               String    @id @default(cuid())
  sourceId         String
  sourceVersionId  String
  blockType        BlockType
  sequenceIndex    Int
  rawText          String
  locationLabel    String
  locationJson     Json
  detectedLanguage String?
  createdAt        DateTime  @default(now())

  source         Source          @relation(fields: [sourceId], references: [id])
  sourceVersion  SourceVersion   @relation(fields: [sourceVersionId], references: [id])
  extractedItems ExtractedItem[]

  @@index([sourceId, sequenceIndex])
}

// =========================================================================
// AI EXTRACTION / REVIEW
// =========================================================================

model ExtractedItem {
  id                  String                        @id @default(cuid())
  sourceBlockId       String
  sourceId            String
  informationType     InformationType
  proposedSectionKey  ClientBrainSectionKey?
  proposedFieldKey    ClientBrainFieldKey?
  proposedGroupHint   String?
  normalizedValueText String?
  normalizedValueJson Json?
  confidence          Float
  detectedLanguage    String?
  reasoningSummary    String?
  suggestedTags       String[]
  isConflictCandidate Boolean                       @default(false)
  aiModel             String?
  validationStatus    ExtractedItemValidationStatus @default(PENDING)
  validationNotes     String?
  duplicateOfItemId   String?
  clientBrainItemId   String?
  createdAt           DateTime                      @default(now())

  sourceBlock SourceBlock   @relation(fields: [sourceBlockId], references: [id])
  source      Source        @relation(fields: [sourceId], references: [id])
  review      ImportReview?
  conflicts   Conflict[]
  tags        Tag[]

  @@index([sourceId])
  @@index([sourceId, informationType])
  @@index([proposedSectionKey, proposedFieldKey])
}

model ImportReview {
  id               String                 @id @default(cuid())
  extractedItemId  String                 @unique
  clientId         String
  status           ImportReviewStatus     @default(PENDING)
  resolutionAction ImportReviewAction?
  editedValueText  String?
  editedValueJson  Json?
  editedSectionKey ClientBrainSectionKey?
  editedFieldKey   ClientBrainFieldKey?
  reviewerId       String?
  reviewedAt       DateTime?
  reviewNotes      String?
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt

  extractedItem ExtractedItem @relation(fields: [extractedItemId], references: [id])

  @@index([clientId, status])
}

// =========================================================================
// CLIENT BRAIN
// =========================================================================

model ClientBrainSection {
  id                        String                @id @default(cuid())
  clientId                  String
  sectionKey                ClientBrainSectionKey
  notes                     String?
  cachedCompletenessPercent Int?
  updatedAt                 DateTime              @updatedAt

  client Client @relation(fields: [clientId], references: [id])

  @@unique([clientId, sectionKey])
}

model ClientBrainItem {
  id                   String                @id @default(cuid())
  clientId             String
  sectionKey           ClientBrainSectionKey
  fieldKey             ClientBrainFieldKey
  groupId              String                @default(cuid())
  subjectLabel         String?
  valueText            String?
  valueJson            Json?
  status               ClientBrainItemStatus @default(DRAFT)
  confidence           Float?
  currentVersionNumber Int                   @default(1)
  createdById          String
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt

  client              Client                   @relation(fields: [clientId], references: [id])
  versions            ClientBrainItemVersion[]
  sourceLinks         ClientBrainItemSource[]
  conflictsAsExisting Conflict[]

  @@index([clientId, sectionKey])
  @@index([clientId, sectionKey, fieldKey])
  @@index([clientId, groupId])
}

model ClientBrainItemVersion {
  id                String                @id @default(cuid())
  clientBrainItemId String
  versionNumber     Int
  valueText         String?
  valueJson         Json?
  status            ClientBrainItemStatus
  confidence        Float?
  changeType        ChangeType
  changedById       String
  changeNote        String?
  createdAt         DateTime              @default(now())

  item ClientBrainItem @relation(fields: [clientBrainItemId], references: [id])

  @@unique([clientBrainItemId, versionNumber])
}

model ClientBrainItemSource {
  id                String   @id @default(cuid())
  clientBrainItemId String
  sourceId          String
  sourceBlockId     String?
  extractedItemId   String?
  approvedById      String
  approvedAt        DateTime @default(now())
  note              String?

  item ClientBrainItem @relation(fields: [clientBrainItemId], references: [id])

  @@index([clientBrainItemId])
  @@index([sourceId])
}

// =========================================================================
// CONFLICTS
// =========================================================================

model Conflict {
  id                String         @id @default(cuid())
  clientId          String
  clientBrainItemId String
  extractedItemId   String
  status            ConflictStatus @default(OPEN)
  detectedReason    String
  similarityScore   Float?
  createdAt         DateTime       @default(now())
  resolvedAt        DateTime?

  client          Client               @relation(fields: [clientId], references: [id])
  clientBrainItem ClientBrainItem      @relation(fields: [clientBrainItemId], references: [id])
  extractedItem   ExtractedItem        @relation(fields: [extractedItemId], references: [id])
  resolutions     ConflictResolution[]

  @@index([clientId, status])
}

model ConflictResolution {
  id                String                 @id @default(cuid())
  conflictId        String
  resolutionType    ConflictResolutionType
  resolvedValueText String?
  resolvedValueJson Json?
  resolvedById      String
  resolvedAt        DateTime               @default(now())
  note              String?

  conflict Conflict @relation(fields: [conflictId], references: [id])

  @@index([conflictId])
}

// =========================================================================
// MISSING DATA / TAGS / AUDIT
// =========================================================================

model MissingDataItem {
  id                String                @id @default(cuid())
  clientId          String
  sectionKey        ClientBrainSectionKey
  fieldKey          ClientBrainFieldKey?
  gapType           MissingDataGapType
  suggestedQuestion String?
  priority          Int?
  generatedAt       DateTime              @default(now())
  resolvedAt        DateTime?

  client Client @relation(fields: [clientId], references: [id])

  @@index([clientId, sectionKey])
}

model Tag {
  id        String   @id @default(cuid())
  clientId  String
  label     String
  createdAt DateTime @default(now())

  client         Client          @relation(fields: [clientId], references: [id])
  sources        Source[]
  extractedItems ExtractedItem[]

  @@unique([clientId, label])
}

model AuditLog {
  id             String      @id @default(cuid())
  organizationId String
  clientId       String?
  actorUserId    String?
  action         AuditAction
  entityType     String
  entityId       String
  metadata       Json?
  createdAt      DateTime    @default(now())

  organization Organization @relation(fields: [organizationId], references: [id])
  client       Client?      @relation(fields: [clientId], references: [id])
  actor        User?        @relation(fields: [actorUserId], references: [id])

  @@index([clientId, createdAt])
  @@index([organizationId, createdAt])
  @@index([entityType, entityId])
}

// =========================================================================
// MODULE 2 — COHORT + BUYING DECISION + BELIEF INTELLIGENCE
//
// Turns the approved Client Brain into a commercial reasoning system:
// Cohort -> Commercial Situation -> Trigger -> Active Problem ->
// Current Workflow -> Current Belief -> Behavior -> Commercial Consequence
// -> Objection/Risk -> Evidence -> Better Belief -> Better Commercial
// Decision. New, normalized models; existing Client Brain COHORTS/BELIEFS
// items are referenced as sources (CohortSourceReference / EvidenceLink),
// never duplicated or overwritten.
// =========================================================================

model Cohort {
  id       String @id @default(cuid())
  clientId String

  // IDENTITY
  name       String
  definition String? // grounded, evidence-based description — never a fictional persona bio
  priority   CohortPriority @default(MEDIUM)

  // COMMERCIAL CONTEXT
  role              String? // this cohort's role/title inside the business (e.g. "Marketing Manager")
  commercialContext String? // why this cohort matters commercially right now

  // CURRENT STATE
  currentWorkflow String?
  currentBelief   String?
  desiredOutcome  String?

  // PSYCHOLOGICAL AND DECISION CONTEXT
  decisionRisk     String?
  emotionalDrivers String[]

  // CONTENT AND ATTENTION CONTEXT
  platformPresence String[]
  attentionNotes   String?

  status               StrategyEntityStatus   @default(DRAFT)
  approvalStatus       StrategyApprovalStatus @default(DRAFT)
  confidence           Float?
  currentVersionNumber Int                    @default(1)
  createdById          String
  updatedById          String?
  archivedAt           DateTime?
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt

  client               Client                  @relation(fields: [clientId], references: [id])
  versions             CohortVersion[]
  sourceReferences     CohortSourceReference[]
  commercialSituations CommercialSituation[]
  buyingDecisions      BuyingDecision[]
  beliefMaps           BeliefMap[]

  @@index([clientId, status])
  @@index([clientId, approvalStatus])
}

model CohortVersion {
  id       String @id @default(cuid())
  cohortId String

  name              String
  definition        String?
  priority          CohortPriority
  role              String?
  commercialContext String?
  currentWorkflow   String?
  currentBelief     String?
  desiredOutcome    String?
  decisionRisk      String?
  emotionalDrivers  String[]
  platformPresence  String[]
  attentionNotes    String?
  status            StrategyEntityStatus
  approvalStatus    StrategyApprovalStatus
  confidence        Float?

  versionNumber Int
  changeType    ChangeType
  changedById   String
  changeNote    String?
  createdAt     DateTime   @default(now())

  cohort Cohort @relation(fields: [cohortId], references: [id])

  @@unique([cohortId, versionNumber])
}

/**
 * Traceability for a cohort back to whatever grounded it — an existing
 * Client Brain item, a raw extracted item, an audience signal, an evidence
 * item, or a manual note. Relation-less FK columns (like
 * ClientBrainItemSource) because a reference can point at any one of several
 * different object graphs.
 */
model CohortSourceReference {
  id       String @id @default(cuid())
  cohortId String

  relationshipType   CohortSourceRelationshipType
  clientBrainItemId  String?
  extractedItemId    String?
  sourceId           String?
  sourceBlockId      String?
  audienceSignalNote String?
  note               String?

  linkedById String
  linkedAt   DateTime @default(now())

  cohort Cohort @relation(fields: [cohortId], references: [id])

  @@index([cohortId])
}

model CommercialSituation {
  id       String @id @default(cuid())
  clientId String
  cohortId String

  title              String
  triggerType        TriggerType
  triggerDescription String?
  activeProblem      String?
  currentWorkflow    String?
  urgencyNote        String?

  status               StrategyEntityStatus   @default(DRAFT)
  approvalStatus       StrategyApprovalStatus @default(DRAFT)
  confidence           Float?
  currentVersionNumber Int                    @default(1)
  createdById          String
  archivedAt           DateTime?
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt

  client          Client                       @relation(fields: [clientId], references: [id])
  cohort          Cohort                       @relation(fields: [cohortId], references: [id])
  versions        CommercialSituationVersion[]
  buyingDecisions BuyingDecision[]
  beliefMaps      BeliefMap[]

  @@index([clientId, status])
  @@index([cohortId])
}

model CommercialSituationVersion {
  id                    String @id @default(cuid())
  commercialSituationId String

  title              String
  triggerType        TriggerType
  triggerDescription String?
  activeProblem      String?
  currentWorkflow    String?
  urgencyNote        String?
  status             StrategyEntityStatus
  approvalStatus     StrategyApprovalStatus
  confidence         Float?

  versionNumber Int
  changeType    ChangeType
  changedById   String
  changeNote    String?
  createdAt     DateTime   @default(now())

  commercialSituation CommercialSituation @relation(fields: [commercialSituationId], references: [id])

  @@unique([commercialSituationId, versionNumber])
}

model BuyingDecision {
  id       String @id @default(cuid())
  clientId String
  cohortId String

  commercialSituationId String?

  title        String
  decisionType DecisionType
  description  String?
  timeframe    String?

  status               StrategyEntityStatus   @default(DRAFT)
  approvalStatus       StrategyApprovalStatus @default(DRAFT)
  confidence           Float?
  currentVersionNumber Int                    @default(1)
  createdById          String
  archivedAt           DateTime?
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt

  client              Client                  @relation(fields: [clientId], references: [id])
  cohort              Cohort                  @relation(fields: [cohortId], references: [id])
  commercialSituation CommercialSituation?    @relation(fields: [commercialSituationId], references: [id])
  versions            BuyingDecisionVersion[]
  participants        BuyingRoleParticipant[]
  objections          Objection[]
  criteria            DecisionCriterion[]

  @@index([clientId, status])
  @@index([cohortId])
  @@index([commercialSituationId])
}

model BuyingDecisionVersion {
  id               String @id @default(cuid())
  buyingDecisionId String

  title          String
  decisionType   DecisionType
  description    String?
  timeframe      String?
  status         StrategyEntityStatus
  approvalStatus StrategyApprovalStatus
  confidence     Float?

  versionNumber Int
  changeType    ChangeType
  changedById   String
  changeNote    String?
  createdAt     DateTime   @default(now())

  buyingDecision BuyingDecision @relation(fields: [buyingDecisionId], references: [id])

  @@unique([buyingDecisionId, versionNumber])
}

/**
 * One seat on a specific buying decision's committee. Always paired with an accessible table — never visualization-only.
 */
model BuyingRoleParticipant {
  id               String @id @default(cuid())
  buyingDecisionId String
  clientId         String // denormalized for isolation checks / indexing, no formal relation (see ImportReview precedent)

  role           BuyingRole
  label          String // e.g. "CEO", "Marketing Manager"
  influenceScore Int? // 1..5, optional
  stance         String? // e.g. "supportive", "possible blocker"
  notes          String?

  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  buyingDecision BuyingDecision @relation(fields: [buyingDecisionId], references: [id])

  @@index([buyingDecisionId])
  @@index([clientId])
}

model Objection {
  id               String @id @default(cuid())
  buyingDecisionId String
  clientId         String

  title          String
  description    String?
  raisedByRole   BuyingRole?
  severity       CohortPriority       @default(MEDIUM)
  resolutionNote String?
  status         StrategyEntityStatus @default(ACTIVE)

  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  buyingDecision BuyingDecision @relation(fields: [buyingDecisionId], references: [id])

  @@index([buyingDecisionId])
  @@index([clientId])
}

model DecisionCriterion {
  id               String @id @default(cuid())
  buyingDecisionId String
  clientId         String

  label      String
  weightNote String?
  importance CohortPriority @default(MEDIUM)

  createdById String
  createdAt   DateTime @default(now())

  buyingDecision BuyingDecision @relation(fields: [buyingDecisionId], references: [id])

  @@index([buyingDecisionId])
  @@index([clientId])
}

/**
 * The central reasoning tool: the 11-part chain from an observed situation
 * through to a better commercial decision. `relevantOfferPlaceholder` is a
 * free-text placeholder until the Offer + Proof + Claims module exists.
 */
model BeliefMap {
  id       String @id @default(cuid())
  clientId String
  cohortId String

  commercialSituationId String?

  observedSituation        String?
  currentInterpretation    String?
  currentBeliefStatement   String
  beliefType               BeliefType @default(WRONG)
  behaviorCaused           String?
  commercialConsequence    String?
  betterBeliefStatement    String?
  betterCommercialDecision String?
  relevantOfferPlaceholder String?

  approvalStatus       StrategyApprovalStatus @default(DRAFT)
  confidence           Float?
  currentVersionNumber Int                    @default(1)
  createdById          String
  archivedAt           DateTime?
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt

  client              Client               @relation(fields: [clientId], references: [id])
  cohort              Cohort               @relation(fields: [cohortId], references: [id])
  commercialSituation CommercialSituation? @relation(fields: [commercialSituationId], references: [id])
  versions            BeliefMapVersion[]
  evidenceLinks       EvidenceLink[]

  @@index([clientId, approvalStatus])
  @@index([cohortId])
  @@index([commercialSituationId])
}

model BeliefMapVersion {
  id          String @id @default(cuid())
  beliefMapId String

  observedSituation        String?
  currentInterpretation    String?
  currentBeliefStatement   String
  beliefType               BeliefType
  behaviorCaused           String?
  commercialConsequence    String?
  betterBeliefStatement    String?
  betterCommercialDecision String?
  relevantOfferPlaceholder String?
  approvalStatus           StrategyApprovalStatus
  confidence               Float?

  versionNumber Int
  changeType    ChangeType
  changedById   String
  changeNote    String?
  createdAt     DateTime   @default(now())

  beliefMap BeliefMap @relation(fields: [beliefMapId], references: [id])

  @@unique([beliefMapId, versionNumber])
}

/**
 * Lightweight evidence linking (spec: full Evidence/Claims Vault is a later
 * module). Links a described piece of evidence — optionally traced to an
 * existing Client Brain PROOF/EVIDENCE item or a raw source — to any strategy
 * entity (cohort, situation, decision, belief, objection).
 */
model EvidenceLink {
  id       String @id @default(cuid())
  clientId String

  targetEntityType StrategicEntityType
  targetEntityId   String
  beliefMapId      String? // convenience relation when the target is a BeliefMap, for the belief-detail evidence pane

  description       String
  evidenceStrength  EvidenceStrength @default(WEAK)
  clientBrainItemId String?
  sourceId          String?
  sourceBlockId     String?
  note              String?

  createdById String
  createdAt   DateTime @default(now())

  client    Client     @relation(fields: [clientId], references: [id])
  beliefMap BeliefMap? @relation(fields: [beliefMapId], references: [id])

  @@index([clientId, targetEntityType, targetEntityId])
  @@index([beliefMapId])
}

/**
 * Thin reference layer for the Strategic Relationship Graph — denormalized
 * title/status pointing at the real row (relation-less entityId, since it can
 * reference many different tables incl. ClientBrainItem). Upserted whenever a
 * strategy entity is created or renamed; relationships connect these rows.
 */
model StrategicEntity {
  id       String @id @default(cuid())
  clientId String

  entityType StrategicEntityType
  entityId   String
  title      String
  status     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  client Client @relation(fields: [clientId], references: [id])

  relationshipsFrom StrategicRelationship[] @relation("RelationshipFrom")
  relationshipsTo   StrategicRelationship[] @relation("RelationshipTo")

  @@unique([clientId, entityType, entityId])
  @@index([clientId])
}

model StrategicRelationship {
  id       String @id @default(cuid())
  clientId String

  fromEntityId     String
  toEntityId       String
  relationshipType StrategicRelationshipType
  note             String?

  createdById String
  createdAt   DateTime @default(now())

  client     Client          @relation(fields: [clientId], references: [id])
  fromEntity StrategicEntity @relation("RelationshipFrom", fields: [fromEntityId], references: [id])
  toEntity   StrategicEntity @relation("RelationshipTo", fields: [toEntityId], references: [id])

  @@index([clientId])
  @@index([fromEntityId])
  @@index([toEntityId])
}

/**
 * An AI-produced strategy suggestion, pending human review. Never auto-
 * becomes approved strategy — see StrategySuggestionReview. `proposedFields`,
 * `sourceReferences`, `possibleConflicts`, `suggestedRelationships` are Json
 * because their shape genuinely varies by suggestionType.
 */
model StrategySuggestion {
  id       String @id @default(cuid())
  clientId String

  suggestionType         StrategySuggestionType
  title                  String
  proposedFields         Json
  sourceReferences       Json
  confidence             Float
  reasoningSummary       String
  missingEvidence        String[]
  possibleConflicts      Json?
  suggestedRelationships Json?

  status                StrategyApprovalStatus @default(AI_SUGGESTED)
  isDuplicateCandidate  Boolean                @default(false)
  duplicateOfEntityType StrategicEntityType?
  duplicateOfEntityId   String?

  aiModel   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  client Client                    @relation(fields: [clientId], references: [id])
  review StrategySuggestionReview?

  @@index([clientId, status])
  @@index([clientId, suggestionType])
}

/**
 * The human-review gate for one AI strategy suggestion. Mirrors ImportReview.
 */
model StrategySuggestionReview {
  id                   String @id @default(cuid())
  strategySuggestionId String @unique
  clientId             String

  status              ImportReviewStatus        @default(PENDING)
  action              StrategySuggestionAction?
  resultingEntityType StrategicEntityType?
  resultingEntityId   String?
  reviewerId          String?
  reviewedAt          DateTime?
  reviewNotes         String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  strategySuggestion StrategySuggestion @relation(fields: [strategySuggestionId], references: [id])

  @@index([clientId, status])
}

/**
 * A point-in-time snapshot of the "Strategy Setup Readiness" report — always
 * labeled as setup readiness, never as a prediction of business success.
 */
model StrategyReadinessSnapshot {
  id       String @id @default(cuid())
  clientId String

  overallScore      Int
  sectionScores     Json
  followUpQuestions String[]

  generatedById String?
  generatedAt   DateTime @default(now())

  client Client @relation(fields: [clientId], references: [id])

  @@index([clientId, generatedAt])
}

// =========================================================================
// MODULE 3 — GUIDED CLIENT SETUP + SCRIPT INTELLIGENCE COMPILER + FIRST REEL GENERATOR
//
// Guided Mode is the default Client Brain experience; the dense Module 1
// Client Brain becomes Expert Mode. A configurable question engine collects
// only information with a Script Impact, reusing existing Module 1/2 data
// wherever a trusted answer already exists. Approved answers compile into a
// versioned ScriptGenerationContext, which the AI turns into a ReelScriptPackage
// behind deterministic validation gates. Nothing here duplicates the Client
// Brain — GuidedSetupAnswer/ScriptIntelligenceField reference existing
// entities via relation-less ids, the same traceability pattern as
// ClientBrainItemSource / CohortSourceReference.
// =========================================================================

model GuidedSetupSession {
  id       String @id @default(cuid())
  clientId String
  userId   String

  entryMode          GuidedSetupEntryMode @default(FULL_GUIDED)
  status             GuidedSetupStatus    @default(IN_PROGRESS)
  currentSection     GuidedSetupSection?
  currentQuestionKey String?

  startedAt   DateTime  @default(now())
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  client  Client              @relation(fields: [clientId], references: [id])
  answers GuidedSetupAnswer[]

  @@index([clientId, status])
}

/**
 * The seeded, global question catalog driving Guided Setup — never
 * hardcoded in a React component. A question may only exist here if it
 * carries at least one ScriptImpact, or is SYSTEM_ONLY and operationally
 * necessary (enforced by validateQuestionDefinition in the domain layer).
 */
model GuidedSetupQuestionDefinition {
  id  String @id @default(cuid())
  key String @unique

  section            GuidedSetupSection
  userFacingQuestion String
  helperText         String?
  example            String?
  answerType         GuidedAnswerType
  options            Json?
  requiredLevel      GuidedRequiredLevel
  scriptImpacts      ScriptImpact[]
  destinationEntity  String?
  destinationField   String?
  conditionalLogic   Json?
  plainLanguageLabel String?
  expertLabel        String?
  displayOrder       Int
  isActive           Boolean             @default(true)
  version            Int                 @default(1)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([section, displayOrder])
}

model GuidedSetupAnswer {
  id        String @id @default(cuid())
  sessionId String
  clientId  String

  questionKey     String
  rawAnswer       String?
  normalizedValue String?
  sourceType      GuidedAnswerSourceType
  sourceReference String?
  confidence      Float?
  approvalStatus  StrategyApprovalStatus @default(DRAFT)

  reviewedById String?
  reviewedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  session GuidedSetupSession @relation(fields: [sessionId], references: [id])
  client  Client             @relation(fields: [clientId], references: [id])

  @@unique([sessionId, questionKey])
  @@index([clientId, questionKey])
}

/**
 * The compiled, queryable projection of "active script-relevant intelligence"
 * for a client — sourced from approved GuidedSetupAnswers and existing
 * Module 1/2 entities alike. This is what scriptContextCompiler reads from;
 * it is a read-optimized index, not a duplicate store of truth.
 */
model ScriptIntelligenceField {
  id       String @id @default(cuid())
  clientId String

  sourceEntityType String
  sourceEntityId   String
  fieldKey         String
  normalizedValue  String
  scriptImpacts    ScriptImpact[]
  approvalStatus   StrategyApprovalStatus @default(DRAFT)
  confidence       Float?

  validFrom  DateTime  @default(now())
  validUntil DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  client Client @relation(fields: [clientId], references: [id])

  @@unique([clientId, fieldKey])
  @@index([clientId, sourceEntityType, sourceEntityId])
}

/**
 * An immutable, versioned compilation of ScriptGenerationContext, ready for AI generation.
 */
model ScriptContextSnapshot {
  id       String  @id @default(cuid())
  clientId String
  cohortId String?

  generationPurpose String
  compiledContext   Json
  sourceManifest    Json
  readiness         Json?
  warnings          String[]

  createdById String?
  createdAt   DateTime @default(now())

  client Client @relation(fields: [clientId], references: [id])

  @@index([clientId, createdAt])
}

model Offer {
  id       String @id @default(cuid())
  clientId String

  name              String
  forWhom           String?
  problemAddressed  String?
  corePromise       String?
  intendedOutcome   String?
  mechanism         String?
  deliverables      String[]
  pricePresentation OfferPricePresentation @default(NOT_SELLING_YET)
  priceText         String?
  excludedOutcomes  String[]
  guarantee         String?
  ctaRoute          String?

  status               StrategyEntityStatus   @default(DRAFT)
  approvalStatus       StrategyApprovalStatus @default(DRAFT)
  currentVersionNumber Int                    @default(1)
  createdById          String
  archivedAt           DateTime?
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt

  client     Client         @relation(fields: [clientId], references: [id])
  versions   OfferVersion[]
  proofItems ProofItem[]

  @@index([clientId, status])
}

model OfferVersion {
  id      String @id @default(cuid())
  offerId String

  name              String
  forWhom           String?
  problemAddressed  String?
  corePromise       String?
  intendedOutcome   String?
  mechanism         String?
  deliverables      String[]
  pricePresentation OfferPricePresentation
  priceText         String?
  excludedOutcomes  String[]
  guarantee         String?
  ctaRoute          String?
  status            StrategyEntityStatus
  approvalStatus    StrategyApprovalStatus

  versionNumber Int
  changeType    ChangeType
  changedById   String
  changeNote    String?
  createdAt     DateTime   @default(now())

  offer Offer @relation(fields: [offerId], references: [id])

  @@unique([offerId, versionNumber])
}

/**
 * A single piece of proof (spec section 13). Lightweight and unversioned,
 * like Objection/DecisionCriterion — additive facts about evidence, not an
 * evolving strategic statement. Never auto-approved: incomplete items are
 * stored as `needsReview` rather than fabricated.
 */
model ProofItem {
  id       String  @id @default(cuid())
  clientId String
  offerId  String?

  proofType           ProofType
  whatHappened        String?
  whoForWhom          String?
  startingPoint       String?
  whatChanged         String?
  overPeriod          String?
  contributingFactors String?
  limitations         String[]
  publicUseStatus     PublicUseStatus        @default(REQUIRES_APPROVAL)
  evidenceStrength    EvidenceStrength       @default(WEAK)
  needsReview         Boolean                @default(false)
  approvalStatus      StrategyApprovalStatus @default(DRAFT)

  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  client Client @relation(fields: [clientId], references: [id])
  offer  Offer? @relation(fields: [offerId], references: [id])

  @@index([clientId, approvalStatus])
  @@index([offerId])
}

/**
 * The parent record for one Reel's generations — the stable id used in /reels/[generationId].
 */
model ReelGeneration {
  id       String @id @default(cuid())
  clientId String
  cohortId String

  contextSnapshotId String
  status            ReelGenerationStatus @default(DRAFT)

  currentVersionNumber Int      @default(1)
  createdById          String
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  client   Client        @relation(fields: [clientId], references: [id])
  versions ReelVersion[]

  @@index([clientId, createdAt])
  @@index([cohortId])
}

/**
 * Each save/regenerate of a Reel creates a new version — the full ReelScriptPackage is never mutated in place.
 */
model ReelVersion {
  id               String @id @default(cuid())
  reelGenerationId String

  packageJson       Json
  selectedHookIndex Int      @default(0)
  validationJson    Json
  versionNumber     Int
  changeNote        String?
  createdById       String
  createdAt         DateTime @default(now())

  reelGeneration ReelGeneration @relation(fields: [reelGenerationId], references: [id])

  @@unique([reelGenerationId, versionNumber])
}
