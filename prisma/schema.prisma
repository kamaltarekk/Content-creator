  CLAIM
  REASON
  APPLICABLE_CONTEXT
  // LEARNINGS
  LEARNING
  LEARNING_CONTEXT
  EVIDENCE_LEVEL
  APPLICABLE_SCOPE
  LEARNING_CONFIDENCE
